{
  "name": "percona-live-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "npm run notes && slidev build",
    "build:pages": "npm run notes && slidev build --base /percona-live-2026/",
    "notes": "node scripts/build-notes.mjs",
    "export": "slidev export",
    "export:pdf": "slidev export --output percona-live-2026.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^0.50.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "mermaid": "^11.15.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.60.0"
  }
}
